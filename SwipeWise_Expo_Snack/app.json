{
  "expo": {
    "name": "SwipeWise",
    "slug": "swipewise",
    "version": "0.5.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "swipewise",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swipewise.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SwipeWise uses your location only when you ask for nearby stores. Your location is not continuously tracked."
        }
      ]
    ]
  }
}

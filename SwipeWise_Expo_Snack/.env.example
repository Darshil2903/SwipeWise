# SwipeWise client-safe Supabase configuration
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# IMPORTANT: GOOGLE_PLACES_API_KEY is a server-side Supabase Edge Function secret.
# Do NOT put GOOGLE_PLACES_API_KEY, SUPABASE_SERVICE_ROLE_KEY, database passwords,
# or any other private/server credential in Expo environment files.

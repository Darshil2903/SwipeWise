# Client-safe Expo variables only.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# DO NOT put GOOGLE_PLACES_API_KEY here.
# Store it with: npx supabase secrets set GOOGLE_PLACES_API_KEY=...
# Optional server-side safety cap (default 4000; max 4900):
# npx supabase secrets set GOOGLE_PLACES_MONTHLY_REQUEST_LIMIT=4000
